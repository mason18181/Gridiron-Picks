# Copy this file's contents into Railway's Variables tab for this service —
# don't commit a real .env file to GitHub.

# Auto-provided by Railway when you attach a Postgres database (leave as-is locally if testing)
DATABASE_URL=postgresql://user:pass@localhost:5432/gridiron

# Your key from the-odds-api.com (free plan)
ODDS_API_KEY=your_odds_api_key_here

# A password only you (the host) will use to unlock host controls in the app
HOST_PASSWORD=choose_a_private_password

PORT=3000
